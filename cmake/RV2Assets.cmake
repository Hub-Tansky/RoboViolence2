# Build-time game assets (ROBO-261, ADR ROBO-261): fetches the packs RV2_ASSETS names into <runtime>/packs/<kind>, where a
# game run from the build tree stacks them like the client's own downloads (placeholders < original < robo_art < url).
# A download that fails warns and keeps the placeholders; nothing here can fail the build. Run at configure time by the
# top CMakeLists.txt; tests/assets_fetch.cmake runs it in script mode (cmake -P) against a local fixture.
#
# rv2_fetch_assets(KINDS <list> OUT <runtime>/packs CACHE <dir> SOURCE <repo root> [URL <url>] [PYTHON <exe>]
#                  [ART_URL <url> ART_SHA256 <hex> ART_VERSION <v>] [ORIGINAL_URL <url> COMMIT <sha>])
# ART_*, ORIGINAL_URL and COMMIT override the pins read from game/src/ArtPack.cpp and DataDownload.cpp (tests only).

if(CMAKE_SCRIPT_MODE_FILE)
  cmake_policy(VERSION 3.25) # script mode (cmake -P, the install script) has no project policies
endif()

# Values of `#define <name> "<value>"` in a source file
function(rv2_read_define file name out)
  file(STRINGS "${file}" line REGEX "^#define ${name} \"[^\"]*\"")
  string(REGEX REPLACE "^#define ${name} \"([^\"]*)\".*" "\\1" value "${line}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Downloads url into the cache file once; ok is TRUE when the file is there afterwards (and matches sha256 when given)
function(rv2_cached_download url file sha256 ok)
  set(${ok} FALSE PARENT_SCOPE)
  if(EXISTS "${file}" AND sha256)
    file(SHA256 "${file}" have)
    if(have STREQUAL sha256)
      set(${ok} TRUE PARENT_SCOPE)
      return()
    endif()
    file(REMOVE "${file}")
  elseif(EXISTS "${file}")
    set(${ok} TRUE PARENT_SCOPE)
    return()
  endif()
  get_filename_component(dir "${file}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  message(STATUS "RV2_ASSETS: downloading ${url}")
  file(DOWNLOAD "${url}" "${file}.part" STATUS status TLS_VERIFY ON INACTIVITY_TIMEOUT 30 TIMEOUT 600)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    list(GET status 1 text)
    file(REMOVE "${file}.part")
    message(WARNING "RV2_ASSETS: could not download ${url} (${text}); keeping placeholders")
    return()
  endif()
  if(sha256)
    file(SHA256 "${file}.part" have)
    if(NOT have STREQUAL sha256)
      file(REMOVE "${file}.part")
      message(WARNING "RV2_ASSETS: ${url} has SHA-256 ${have}, expected ${sha256}; keeping placeholders")
      return()
    endif()
  endif()
  file(RENAME "${file}.part" "${file}")
  set(${ok} TRUE PARENT_SCOPE)
endfunction()

# Unpacks archive into dest (created) with `cmake -E tar`, which reports a broken archive instead of stopping CMake;
# members limits it to those paths. ok is FALSE on failure, and dest is removed.
function(rv2_extract archive dest ok)
  file(REMOVE_RECURSE "${dest}")
  file(MAKE_DIRECTORY "${dest}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}" ${ARGN} WORKING_DIRECTORY "${dest}"
                  RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(rc EQUAL 0)
    set(${ok} TRUE PARENT_SCOPE)
  else()
    file(REMOVE_RECURSE "${dest}")
    set(${ok} FALSE PARENT_SCOPE)
    message(WARNING "RV2_ASSETS: could not unpack ${archive}: ${err}")
  endif()
endfunction()

# Moves partial into place as dest and writes the stamp, so an unchanged pin skips all work next time
function(rv2_install_pack partial dest stamp)
  file(REMOVE_RECURSE "${dest}")
  file(RENAME "${partial}" "${dest}")
  file(WRITE "${dest}/.rv2-assets-stamp" "${stamp}\n")
endfunction()

function(rv2_pack_current dest stamp out)
  set(${out} FALSE PARENT_SCOPE)
  if(EXISTS "${dest}/.rv2-assets-stamp")
    file(READ "${dest}/.rv2-assets-stamp" have)
    string(STRIP "${have}" have)
    if(have STREQUAL stamp)
      set(${out} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# robo_art: the pinned art pack (ADR ROBO-260), checked against its SHA-256 before unpacking
function(rv2_fetch_robo_art out cache url sha256 version)
  set(dest "${out}/robo_art")
  set(stamp "robo_art ${version} ${sha256}")
  rv2_pack_current("${dest}" "${stamp}" current)
  if(current)
    return()
  endif()
  if(NOT version OR NOT url OR NOT sha256)
    message(WARNING "RV2_ASSETS: the game has no art pack pin; robo_art skipped")
    return()
  endif()
  string(SUBSTRING "${sha256}" 0 12 short)
  rv2_cached_download("${url}" "${cache}/rv2-art-${version}-${short}.tar.gz" "${sha256}" ok)
  if(NOT ok)
    return()
  endif()
  set(partial "${dest}.partial")
  rv2_extract("${cache}/rv2-art-${version}-${short}.tar.gz" "${partial}" unpacked)
  if(NOT unpacked)
    return()
  endif()
  if(NOT EXISTS "${partial}/main/pack.tsv")
    file(REMOVE_RECURSE "${partial}")
    message(WARNING "RV2_ASSETS: art pack ${version} has no main/pack.tsv; keeping placeholders")
    return()
  endif()
  file(WRITE "${partial}/VERSION" "${version}\n") # what artPackInstalled() compares with the pin
  rv2_install_pack("${partial}" "${dest}" "${stamp}")
  message(STATUS "RV2_ASSETS: art pack ${version} in ${dest}")
endfunction()

# original: BV2's Content/main at the pinned upstream commit (ADR 0040); every Content/main file of
# tools/original-assets.sha256 must match, or nothing is installed
function(rv2_fetch_original out cache source commit url)
  set(dest "${out}/original")
  set(stamp "original ${commit}")
  rv2_pack_current("${dest}" "${stamp}" current)
  if(current)
    return()
  endif()
  set(zip "${cache}/BaboViolent2-${commit}.zip")
  rv2_cached_download("${url}" "${zip}" "" ok)
  if(NOT ok)
    return()
  endif()
  set(partial "${dest}.partial")
  set(inner "BaboViolent2-${commit}/BaboViolent2/Content/main")
  rv2_extract("${zip}" "${partial}" unpacked "${inner}")
  if(NOT unpacked)
    file(REMOVE "${zip}")
    return()
  endif()
  file(STRINGS "${source}/tools/original-assets.sha256" rows REGEX "  BaboViolent2/Content/main/")
  set(bad "")
  foreach(row IN LISTS rows)
    string(SUBSTRING "${row}" 0 64 want)
    string(SUBSTRING "${row}" 66 -1 path)
    string(REPLACE "BaboViolent2/Content/main/" "" rel "${path}")
    set(have "")
    if(EXISTS "${partial}/${inner}/${rel}")
      file(SHA256 "${partial}/${inner}/${rel}" have)
    endif()
    if(NOT have STREQUAL want)
      list(APPEND bad "${rel}")
    endif()
  endforeach()
  list(LENGTH rows count)
  if(bad OR count EQUAL 0)
    file(REMOVE_RECURSE "${partial}")
    file(REMOVE "${zip}") # fetched again next configure
    list(LENGTH bad nbad)
    message(WARNING "RV2_ASSETS: ${nbad} of ${count} original files do not match tools/original-assets.sha256; keeping placeholders")
    return()
  endif()
  file(MAKE_DIRECTORY "${partial}/pack")
  file(RENAME "${partial}/${inner}" "${partial}/pack/main")
  rv2_install_pack("${partial}/pack" "${dest}" "${stamp}")
  file(REMOVE_RECURSE "${partial}")
  message(STATUS "RV2_ASSETS: original BV2 data (${count} files checked) in ${dest}")
endfunction()

# url: any pack with a main/pack.tsv (ADR 0065), at the top of the archive or one folder down; no pin, so it warns
function(rv2_fetch_url out cache source url python)
  set(dest "${out}/url")
  if(NOT url)
    message(WARNING "RV2_ASSETS: url needs RV2_ASSETS_URL; skipped")
    return()
  endif()
  if(NOT url MATCHES "^(https|file)://")
    message(WARNING "RV2_ASSETS: RV2_ASSETS_URL must be an https:// (or file://) URL; skipped")
    return()
  endif()
  string(SHA256 key "${url}")
  string(SUBSTRING "${key}" 0 16 key)
  set(stamp "url ${url}")
  rv2_pack_current("${dest}" "${stamp}" current)
  if(current)
    return()
  endif()
  message(WARNING "RV2_ASSETS: ${url} has no hash pin; the build trusts whatever it serves")
  string(REGEX MATCH "\\.(tar\\.gz|tgz|zip)$" ext "${url}")
  if(NOT ext)
    set(ext ".tar.gz")
  endif()
  rv2_cached_download("${url}" "${cache}/url-${key}${ext}" "" ok)
  if(NOT ok)
    return()
  endif()
  set(partial "${dest}.partial")
  rv2_extract("${cache}/url-${key}${ext}" "${partial}" unpacked)
  if(NOT unpacked)
    file(REMOVE "${cache}/url-${key}${ext}")
    return()
  endif()
  set(root "")
  if(EXISTS "${partial}/main/pack.tsv")
    set(root "${partial}")
  else()
    file(GLOB tops LIST_DIRECTORIES true "${partial}/*")
    foreach(top IN LISTS tops)
      if(NOT root AND EXISTS "${top}/main/pack.tsv")
        set(root "${top}")
      endif()
    endforeach()
  endif()
  set(problem "")
  if(NOT root)
    set(problem "it has no main/pack.tsv")
  elseif(python)
    execute_process(COMMAND "${python}" "${source}/tools/check-pack.py" "${root}/main"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE log)
    if(NOT rc EQUAL 0)
      set(problem "tools/check-pack.py failed:\n${log}")
    endif()
  else()
    set(problem "Python 3 is needed for tools/check-pack.py")
  endif()
  if(problem)
    file(REMOVE_RECURSE "${partial}")
    file(REMOVE "${cache}/url-${key}${ext}")
    message(WARNING "RV2_ASSETS: ${url} skipped, ${problem}")
    return()
  endif()
  if(NOT root STREQUAL partial)
    file(REMOVE_RECURSE "${partial}.root")
    file(RENAME "${root}" "${partial}.root")
    file(REMOVE_RECURSE "${partial}")
    set(partial "${partial}.root")
  endif()
  rv2_install_pack("${partial}" "${dest}" "${stamp}")
  message(STATUS "RV2_ASSETS: pack from ${url} in ${dest}")
endfunction()

function(rv2_fetch_assets)
  cmake_parse_arguments(A "" "OUT;CACHE;SOURCE;URL;PYTHON;ART_URL;ART_SHA256;ART_VERSION;ORIGINAL_URL;COMMIT" "KINDS" ${ARGN})
  set(known none robo_art original url)
  foreach(kind IN LISTS A_KINDS)
    if(NOT kind IN_LIST known)
      message(WARNING "RV2_ASSETS: unknown value '${kind}' (use robo_art, original, url or none)")
    endif()
  endforeach()
  # A kind no longer asked for is removed, so the game never stacks a pack the build dropped
  foreach(kind robo_art original url)
    if(NOT kind IN_LIST A_KINDS)
      file(REMOVE_RECURSE "${A_OUT}/${kind}")
    endif()
  endforeach()
  if("none" IN_LIST A_KINDS)
    return() # no network access at all
  endif()
  file(MAKE_DIRECTORY "${A_OUT}")
  if("original" IN_LIST A_KINDS)
    set(commit "${A_COMMIT}")
    if(NOT commit)
      rv2_read_define("${A_SOURCE}/game/src/DataDownload.cpp" BV2_UPSTREAM_COMMIT commit)
    endif()
    if(NOT A_ORIGINAL_URL)
      set(A_ORIGINAL_URL "https://github.com/Daivuk/BaboViolent2/archive/${commit}.zip")
    endif()
    rv2_fetch_original("${A_OUT}" "${A_CACHE}" "${A_SOURCE}" "${commit}" "${A_ORIGINAL_URL}")
  endif()
  if("robo_art" IN_LIST A_KINDS)
    set(pin "${A_SOURCE}/game/src/ArtPack.cpp")
    if(NOT A_ART_URL)
      rv2_read_define("${pin}" RV2_ART_PACK_URL A_ART_URL)
    endif()
    if(NOT A_ART_SHA256)
      rv2_read_define("${pin}" RV2_ART_PACK_SHA256 A_ART_SHA256)
    endif()
    if(NOT A_ART_VERSION)
      rv2_read_define("${pin}" RV2_ART_PACK_VERSION A_ART_VERSION)
    endif()
    rv2_fetch_robo_art("${A_OUT}" "${A_CACHE}" "${A_ART_URL}" "${A_ART_SHA256}" "${A_ART_VERSION}")
  endif()
  if("url" IN_LIST A_KINDS)
    rv2_fetch_url("${A_OUT}" "${A_CACHE}" "${A_SOURCE}" "${A_URL}" "${A_PYTHON}")
  endif()
endfunction()

# Default download cache, outside any build tree (a clean build does not download again)
function(rv2_default_assets_cache out)
  if(WIN32 AND DEFINED ENV{LOCALAPPDATA})
    set(dir "$ENV{LOCALAPPDATA}/RoboViolence2/assets-cache")
  elseif(APPLE AND DEFINED ENV{HOME})
    set(dir "$ENV{HOME}/Library/Caches/RoboViolence2/assets")
  elseif(DEFINED ENV{XDG_CACHE_HOME})
    set(dir "$ENV{XDG_CACHE_HOME}/roboviolence2/assets")
  elseif(DEFINED ENV{HOME})
    set(dir "$ENV{HOME}/.cache/roboviolence2/assets")
  else()
    set(dir "${CMAKE_BINARY_DIR}/assets-cache")
  endif()
  set(${out} "${dir}" PARENT_SCOPE)
endfunction()

# The SHA-256 of every original asset (tools/original-assets.sha256)
function(rv2_original_hashes source out)
  file(STRINGS "${source}/tools/original-assets.sha256" rows)
  set(list "")
  foreach(row IN LISTS rows)
    string(SUBSTRING "${row}" 0 64 hash)
    list(APPEND list "${hash}")
  endforeach()
  set(${out} "${list}" PARENT_SCOPE)
endfunction()

# Files under dir whose SHA-256 is in hashes: release installs refuse them (the original data is not redistributable)
function(rv2_original_files_in dir hashes out)
  file(GLOB_RECURSE files LIST_DIRECTORIES false "${dir}/*")
  set(found "")
  foreach(f IN LISTS files)
    if(NOT IS_SYMLINK "${f}")
      file(SHA256 "${f}" h)
      if(h IN_LIST hashes)
        list(APPEND found "${f}")
      endif()
    endif()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

# Script mode: cmake -DKINDS=... -DOUT=... -DCACHE=... -DSOURCE=... [-DURL= -DPYTHON= -DART_URL= ...] -P RV2Assets.cmake
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  rv2_fetch_assets(KINDS ${KINDS} OUT "${OUT}" CACHE "${CACHE}" SOURCE "${SOURCE}" URL "${URL}" PYTHON "${PYTHON}"
                   ART_URL "${ART_URL}" ART_SHA256 "${ART_SHA256}" ART_VERSION "${ART_VERSION}"
                   ORIGINAL_URL "${ORIGINAL_URL}" COMMIT "${COMMIT}")
endif()
