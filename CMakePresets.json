{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": {
        "BV2_SANITIZE": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (GCC 13+ or Clang 17+)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-x64-asan",
      "displayName": "Linux x64, ASan+UBSan",
      "inherits": [
        "linux-x64",
        "asan"
      ]
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (12.0+)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-arm64-asan",
      "displayName": "macOS arm64, ASan+UBSan",
      "inherits": [
        "macos-arm64",
        "asan"
      ]
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (optional)",
      "inherits": "macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "VCPKG_TARGET_TRIPLET": "universal-osx"
      }
    },
    {
      "name": "win-x64-msvc",
      "displayName": "Windows x64, Ninja + MSVC (run from a Developer PowerShell)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "win-x64-msvc-asan",
      "displayName": "Windows x64, ASan",
      "inherits": [
        "win-x64-msvc",
        "asan"
      ]
    },
    {
      "name": "win-arm64-msvc",
      "displayName": "Windows arm64 (optional)",
      "inherits": "win-x64-msvc",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static"
      }
    },
    {
      "name": "win-x64-vs",
      "displayName": "Windows x64, Visual Studio generator (.sln; optional)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win-x64-vs",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-x64-asan",
      "configurePreset": "linux-x64-asan"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-asan",
      "configurePreset": "macos-arm64-asan"
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    },
    {
      "name": "win-x64-msvc",
      "configurePreset": "win-x64-msvc"
    },
    {
      "name": "win-x64-msvc-asan",
      "configurePreset": "win-x64-msvc-asan"
    },
    {
      "name": "win-arm64-msvc",
      "configurePreset": "win-arm64-msvc"
    },
    {
      "name": "win-x64-vs",
      "configurePreset": "win-x64-vs"
    }
  ]
}
