<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent for tools/playtest/agent.sh. Template: install replaces __HOME__ (tools/playtest/README.md). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.roboviolence2.playtest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/RV2-playtest/bin/agent.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/RV2-playtest/agent.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/RV2-playtest/agent.log</string>
</dict>
</plist>
