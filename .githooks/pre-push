#!/bin/sh
# Blocks pushes to non-Hub-Tansky remotes and of commits with another author/committer email.
expected="337104978+Hub-Tansky@users.noreply.github.com"
remote="$1"; url="$2"
case "$url" in
  *github.com:Hub-Tansky/*|*github.com/Hub-Tansky/*) ;;
  *) echo "pre-push: remote '$url' is not under Hub-Tansky/. Refusing." >&2; exit 1 ;;
esac
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes=$remote"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %ae %ce' $range | awk -v e="$expected" '$2!=e || $3!=e')
  if [ -n "$bad" ]; then
    echo "pre-push: commits with a non-Hub-Tansky email in $local_ref:" >&2
    echo "$bad" >&2
    fail=1
  fi
done
exit $fail
