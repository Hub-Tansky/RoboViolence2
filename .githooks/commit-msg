#!/bin/sh
# RoboViolence2 commit-msg: no Claude attribution trailers in commits (owner rule; ROBO-256, ADR ROBO-256).
# The PR body carries the attribution instead. Never bypass with --no-verify.
if grep -Eiq '^(Co-Authored-By:[[:space:]]*Claude|Claude-Session:)' "$1"; then
  echo "commit-msg: remove the 'Co-Authored-By: Claude' and 'Claude-Session:' lines; commits carry no Claude trailers (ADR ROBO-256)." >&2
  exit 1
fi
exit 0
